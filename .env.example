# Register an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Register this exact redirect URI in your Spotify app. Use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
# Generate a unique value with: openssl rand -hex 32
SESSION_SECRET=

# Server-only cosine.club API key: https://cosine.club/account/api
COSINE_API_KEY=

# Optional local Downloads tool paths
YTDLP_PATH=/opt/homebrew/bin/yt-dlp
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
